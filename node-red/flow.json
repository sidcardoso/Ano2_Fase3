[
  {
    "id": "cardioia-tab",
    "type": "tab",
    "label": "CardioIA - Monitoramento",
    "disabled": false,
    "info": "Dashboard demonstrativo para telemetria sintética do ESP32 PAC-001."
  },
  {
    "id": "cardioia-broker",
    "type": "mqtt-broker",
    "name": "HiveMQ Public - demonstracao",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "cardioia-dashboard-PAC-001",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "cardioia-input",
    "type": "mqtt in",
    "z": "cardioia-tab",
    "name": "Telemetria PAC-001",
    "topic": "fiap/cardioia/PAC-001/#",
    "qos": "0",
    "datatype": "json",
    "broker": "cardioia-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 180,
    "y": 200,
    "wires": [["cardioia-normalize"]]
  },
  {
    "id": "cardioia-normalize",
    "type": "function",
    "z": "cardioia-tab",
    "name": "Separar sinais, alertas e status",
    "func": "const data = msg.payload;\nif (!data || typeof data !== 'object' || Array.isArray(data)) return null;\nconst topic = String(msg.topic || '');\nif (topic.endsWith('/vitals')) {\n    const outputs = [null, null, null, null];\n    const bpm = Number(data.bpm);\n    if (Number.isFinite(bpm)) outputs[0] = { topic: 'BPM', payload: bpm };\n    if (typeof data.temp_c === 'number' && Number.isFinite(data.temp_c)) outputs[1] = { payload: data.temp_c };\n    const alerts = Array.isArray(data.alerts) ? data.alerts.filter(value => typeof value === 'string') : [];\n    outputs[2] = { payload: alerts.length ? `ALERTA: ${alerts.join(', ')}` : 'NORMAL' };\n    const age = Number(data.age_s);\n    const freshness = data.buffered || age < 0 || age > 7 ? 'DADOS SINCRONIZADOS (com atraso)' : 'DADOS AO VIVO';\n    outputs[3] = { payload: `${freshness} | fila: ${Number(data.queue) || 0}` };\n    return outputs;\n}\nif (topic.endsWith('/status')) {\n    const state = String(data.state || 'desconhecido').toUpperCase();\n    const queue = Number(data.queue) || 0;\n    const dropped = Number(data.dropped) || 0;\n    return [null, null, null, { payload: `${state} | fila: ${queue} | descartadas: ${dropped}` }];\n}\nreturn null;",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 200,
    "wires": [["cardioia-chart"], ["cardioia-gauge"], ["cardioia-alert"], ["cardioia-status"]]
  },
  {
    "id": "cardioia-chart",
    "type": "ui_chart",
    "z": "cardioia-tab",
    "name": "Frequencia cardiaca",
    "group": "cardioia-group",
    "order": 1,
    "width": 12,
    "height": 6,
    "label": "Frequencia cardiaca (bpm)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Aguardando leituras MQTT",
    "dot": false,
    "ymin": "0",
    "ymax": "240",
    "removeOlder": 1,
    "removeOlderPoints": "120",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "useUTC": false,
    "colors": ["#166534", "#0284C7", "#B45309", "#B91C1C", "#7C3AED", "#475569", "#0F766E", "#A21CAF", "#4D7C0F"],
    "outputs": 1,
    "x": 690,
    "y": 140,
    "wires": [[]]
  },
  {
    "id": "cardioia-gauge",
    "type": "ui_gauge",
    "z": "cardioia-tab",
    "name": "Temperatura",
    "group": "cardioia-group",
    "order": 2,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperatura corporal",
    "label": "graus C",
    "format": "{{value}}",
    "min": 30,
    "max": 42,
    "colors": ["#15803D", "#D97706", "#B91C1C"],
    "seg1": 35,
    "seg2": 38,
    "diff": false,
    "className": "",
    "x": 690,
    "y": 220,
    "wires": [[]]
  },
  {
    "id": "cardioia-alert",
    "type": "ui_text",
    "z": "cardioia-tab",
    "group": "cardioia-group",
    "order": 3,
    "width": 6,
    "height": 2,
    "name": "Alerta clinico simulado",
    "label": "Alerta local",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "className": "",
    "x": 690,
    "y": 300,
    "wires": [[]]
  },
  {
    "id": "cardioia-status",
